<?xml version="1.0"?>
<!-- AgriRover GH-1 robot description. Dimensions mirror config/rover.yaml (checked by software/tests/test_ros_assets.py).
     Frames follow REP-105: base_footprint (floor, under the axle centre) -> base_link (axle centre). -->
<robot name="agrirover_gh1" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="use_gazebo" default="false"/>
  <xacro:property name="wheel_radius" value="0.050"/>
  <xacro:property name="wheel_width" value="0.024"/>
  <xacro:property name="track" value="0.330"/>
  <xacro:property name="deck_length" value="0.460"/>
  <xacro:property name="deck_width" value="0.300"/>
  <xacro:property name="deck_bottom_z" value="0.073"/>
  <xacro:property name="deck_top_z" value="0.180"/>
  <xacro:property name="caster_x" value="0.190"/>
  <xacro:property name="lidar_x" value="0.150"/>
  <xacro:property name="lidar_z" value="0.215"/>
  <xacro:property name="mast_x" value="-0.150"/>
  <xacro:property name="mast_top_z" value="1.250"/>
  <xacro:property name="camera_z" value="1.230"/>
  <xacro:property name="camera_tilt" value="${radians(35.0)}"/>
  <xacro:property name="body_mass" value="8.0"/>

  <material name="alu"><color rgba="0.75 0.77 0.8 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${(deck_bottom_z + deck_top_z) / 2 - wheel_radius}"/>
      <geometry><box size="${deck_length} ${deck_width} ${deck_top_z - deck_bottom_z}"/></geometry>
      <material name="alu"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${(deck_bottom_z + deck_top_z) / 2 - wheel_radius}"/>
      <geometry><box size="${deck_length + 0.04} ${deck_width} ${deck_top_z - deck_bottom_z}"/></geometry>
    </collision>
    <inertial>  <!-- lumped body: mass budget minus wheels; box inertia about the CG from the mechanical calcs -->
      <origin xyz="-0.02 0 0.10"/>
      <mass value="${body_mass}"/>
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.20" iyz="0" izz="0.20"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name side">
    <link name="${name}_wheel">
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="black"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
      <inertial><mass value="0.25"/><inertia ixx="0.00017" ixy="0" ixz="0" iyy="0.00031" iyz="0" izz="0.00017"/></inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel"/>
      <origin xyz="0 ${side * track / 2} 0"/><axis xyz="0 1 0"/>
      <limit effort="1.0" velocity="15.7"/>
    </joint>
  </xacro:macro>
  <xacro:wheel name="left" side="1"/>
  <xacro:wheel name="right" side="-1"/>

  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster">
      <visual><geometry><sphere radius="0.020"/></geometry><material name="black"/></visual>
      <collision><geometry><sphere radius="0.020"/></geometry></collision>
      <inertial><mass value="0.15"/><inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/></inertial>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/><child link="${name}_caster"/>
      <origin xyz="${x} 0 ${0.020 - wheel_radius}"/>
    </joint>
  </xacro:macro>
  <xacro:caster name="front" x="${caster_x}"/>
  <xacro:caster name="rear" x="${-caster_x}"/>

  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.028" length="0.04"/></geometry><material name="black"/></visual>
    <inertial><mass value="0.11"/><inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00004"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_footprint"/><child link="lidar_link"/><origin xyz="${lidar_x} 0 ${lidar_z}"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0.08 0.04 0.06"/></joint>

  <link name="mast_link">
    <visual><origin xyz="0 0 ${(mast_top_z - deck_top_z) / 2}"/><geometry><box size="0.02 0.02 ${mast_top_z - deck_top_z}"/></geometry><material name="alu"/></visual>
    <collision><origin xyz="0 0 ${(mast_top_z - deck_top_z) / 2}"/><geometry><box size="0.02 0.02 ${mast_top_z - deck_top_z}"/></geometry></collision>
    <inertial><origin xyz="0 0 0.6"/><mass value="0.9"/><inertia ixx="0.11" ixy="0" ixz="0" iyy="0.11" iyz="0" izz="0.0002"/></inertial>
  </link>
  <joint name="mast_joint" type="fixed"><parent link="base_footprint"/><child link="mast_link"/><origin xyz="${mast_x} 0 ${deck_top_z}"/></joint>

  <!-- camera_*_link: x forward (viewing direction), tilted down; *_optical_frame follows the image convention (z forward) -->
  <xacro:macro name="camera" params="name yaw">
    <link name="camera_${name}_link"><visual><geometry><box size="0.03 0.04 0.03"/></geometry><material name="black"/></visual></link>
    <joint name="camera_${name}_joint" type="fixed">
      <parent link="base_footprint"/><child link="camera_${name}_link"/>
      <origin xyz="${mast_x} 0 ${camera_z}" rpy="0 ${camera_tilt} ${yaw}"/>
    </joint>
    <link name="camera_${name}_optical_frame"/>
    <joint name="camera_${name}_optical_joint" type="fixed">
      <parent link="camera_${name}_link"/><child link="camera_${name}_optical_frame"/><origin rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
  </xacro:macro>
  <xacro:camera name="left" yaw="${pi/2}"/>
  <xacro:camera name="right" yaw="${-pi/2}"/>

  <link name="env_link"/>
  <joint name="env_joint" type="fixed"><parent link="mast_link"/><child link="env_link"/><origin xyz="0.056 0 0.94"/></joint>

  <xacro:if value="$(arg use_gazebo)">
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${track}</wheel_separation><wheel_radius>${wheel_radius}</wheel_radius>
        <max_linear_acceleration>0.5</max_linear_acceleration><max_linear_velocity>0.5</max_linear_velocity>
        <topic>cmd_vel</topic><odom_topic>odom</odom_topic><tf_topic>tf</tf_topic>
        <frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id><odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
    </gazebo>
    <gazebo reference="front_caster"><mu1>0.02</mu1><mu2>0.02</mu2></gazebo>
    <gazebo reference="rear_caster"><mu1>0.02</mu1><mu2>0.02</mu2></gazebo>
    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <topic>scan</topic><gz_frame_id>lidar_link</gz_frame_id><update_rate>10</update_rate>
        <lidar><scan><horizontal><samples>500</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.05</min><max>12.0</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise></lidar>
      </sensor>
    </gazebo>
    <gazebo reference="imu_link"><sensor name="imu" type="imu"><topic>imu/data_raw</topic><gz_frame_id>imu_link</gz_frame_id><update_rate>100</update_rate></sensor></gazebo>
    <xacro:macro name="gz_camera" params="name">
      <gazebo reference="camera_${name}_link">
        <sensor name="camera_${name}" type="camera">
          <topic>camera_${name}/image_raw</topic><gz_frame_id>camera_${name}_optical_frame</gz_frame_id><update_rate>5</update_rate>
          <camera><horizontal_fov>1.2217</horizontal_fov><image><width>1280</width><height>720</height></image><clip><near>0.05</near><far>10</far></clip></camera>
        </sensor>
      </gazebo>
    </xacro:macro>
    <xacro:gz_camera name="left"/>
    <xacro:gz_camera name="right"/>
  </xacro:if>
</robot>
