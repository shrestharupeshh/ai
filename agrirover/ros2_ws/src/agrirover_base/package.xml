<?xml version="1.0"?>
<package format="3">
  <name>agrirover_base</name>
  <version>0.1.0</version>
  <description>ROS 2 bridge to the AgriRover STM32 base controller (cmd_vel, wheel odometry, gyro, battery, safety state)</description>
  <maintainer email="maintainer@example.com">AgriRover maintainers</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
